# Repository root. The project itself lives in anumaan/ and carries its own
# .gitignore; a .gitignore only governs its own directory downwards, so rules
# for files sitting HERE, beside anumaan/, have to live in this file.

# The SIH deck. Kept on disk, deliberately out of the repository: a 1.2 MB
# binary pair that changes wholesale on every edit and is not part of the
# software being reviewed.
ANUMAAN_SIH26103_Idea.pptx
ANUMAAN_SIH26103_Idea.pdf
*.pptx
*.potx
*.ppt
*.docx
*.doc
*.pdf

# Local assistant and editor state
.claude/
.cursor/
.vscode/
.idea/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Deck figures generated for the slides (fig01-fig13). Same reason as the
# deck itself: presentation material, not the software.
deck-assets/

# Secrets and local dependencies, anywhere in the tree. The project's own
# .gitignore has these too; repeating them here guards any new folder.
.env
.env.*
*.key
*.pem
*.p12
*.pfx
secrets/
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# Audit logs (ANUMAAN_AUDIT_FILE) hold who viewed and exported what. They stay
# on the server's volume, never in git.
*.jsonl

# Logs
*.log
npm-debug.log*
