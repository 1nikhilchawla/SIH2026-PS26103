# Environment
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Source corpus: 142 MB of PDFs. They are reproducible with
# `./run.ps1 -Harvest`, and their SHA-256 hashes ARE tracked in
# data/raw/manifest.csv, so corpus integrity survives without committing the
# binaries - scripts/verify_corpus.py re-checks them after a fresh harvest.
data/raw/*.pdf
!data/raw/manifest.csv

# Parser intermediates - regenerated by scripts/parse_paimana.py
data/interim/

# Local working output: run logs, endpoint probes, scratch files.
results/_*
results/*.log
results/*.err
results/paimana/_*.log
results/d1_*.json

# Synthetic-era artefacts. The synthetic panel was a method demonstration
# before the real PAIMANA corpus parsed; nothing in the deploy reads any of
# it, and shipping it next to the real results is what produces a mixed
# screen where a reviewer cannot tell which numbers are real.
# All of it regenerates locally in one line:
#     python scripts/synth_panel.py && python scripts/train_t1.py \
#       && python scripts/build_demo.py
data/synthetic/
demo/index.html
demo/audit.html
demo/honesty.html
results/metrics.json
results/predictions.csv
results/lead_time.csv
results/lead_time.png
results/baseline_comparison.png
results/reliability_logistic.csv
results/reliability_lightgbm.csv
results/reliability_logistic.png
results/reliability_lightgbm.png

# KEEP the artefacts below: the deploy copies them into the image, and the
# demo pages and the rubric quote them. They are small, and without
# panel.csv the container cannot build at all (the Dockerfile's schema check
# fails by design).
!results/paimana/panel.csv
!results/paimana/panel_provenance.json
!results/paimana/manifest_verification.json
!results/paimana/reconciliation.csv
!results/paimana/reconciliation_meta.json
!results/paimana/metrics_slip.json
!results/paimana/metrics_cost.json
!results/paimana/precision_at_k.json
!results/paimana/reliability_slip.json
!results/paimana/shap_slip.json
!results/paimana/cost_target_diagnostic.json

# Decks, documents and exports. The SIH deck currently lives one level up in
# Desktop/SIH/, outside this repo, so it is already out of scope - these
# patterns are here so it stays out if it is ever moved in. Nothing in the
# deploy needs a .pdf or .pptx; the PAIMANA source PDFs are ignored above.
*.pptx
*.potx
*.ppt
*.docx
*.doc
*.pdf
*.xlsx

# Agent and assistant state
.claude/
.cursor/
.aider*

# Scratch probes from debugging sessions, at the project root only. Kept on
# disk because they document how the parser bugs were found, but nothing
# imports them and they are not part of the pipeline - see run.ps1.
# The leading slash matters: scripts/probe_endpoints.py and scripts/probe_v2.py
# are cited in results/EVIDENCE.md as the record of how the portal's JSON
# endpoints were discovered, and must stay tracked.
/probe_*.py

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
